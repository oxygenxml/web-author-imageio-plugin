<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.oxygenxml</groupId>
    <artifactId>oxygen-plugins-superpom</artifactId>
    <version>29.0-SNAPSHOT</version>
  </parent>  
  <artifactId>web-author-imageio-plugin</artifactId>
  <name>Web Author ImageIO Plugin</name>
  <description>Web Author plugin for rendering images no supported natively by web browsers</description>
  
  <developers>
    <developer>
      <name>Mihai Coanda</name>
      <email>mihai_coanda@sync.ro</email>
      <roles>
        <role>manager</role>
      </roles>
    </developer>
  </developers>

  <properties>
    <monkeys.version>3.8.2</monkeys.version>
    <jcgm.image.version>0.2.2</jcgm.image.version>
    <target.jre.version>21</target.jre.version>
  </properties>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <!-- loaded in the plugin classloader -->
          <execution>
            <id>download-deps</id>
            <configuration>
              <excludeGroupIds>org.apache.pdfbox</excludeGroupIds>
            </configuration>
          </execution>
          <!-- loaded in the main classloader -->
          <execution>
            <id>pdfbox</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/global</outputDirectory>
              <includeGroupIds>org.apache.pdfbox</includeGroupIds>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <!-- 
            Strip CGMImageReader class so our patched version is the only one on the classpath,
            and lower the class file version so the JAR can be loaded on Java 17
          -->
          <execution>
            <id>dedupe-cgm-image-reader</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/build-tools"/>
                <javac srcdir="${basedir}/build-tools" destdir="${project.build.directory}/build-tools"
                  includeantruntime="false"/>
                <java classname="ClassFileDowngrader" classpath="${project.build.directory}/build-tools"
                  fork="true" failonerror="true">
                  <arg value="${basedir}/lib/jcgm-image-${jcgm.image.version}.jar"/>
                  <arg value="${project.build.directory}/lib/jcgm-image-${jcgm.image.version}.jar"/>
                  <arg value="61"/>
                  <arg value="65"/>
                  <arg value="net/sf/jcgm/imageio/plugins/cgm/CGMImageReader.class"/>
                </java>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <id>make-assembly</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>assembly.xml</descriptor>
              </descriptors>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>ro.sync.compliance</groupId>
        <artifactId>compliance-mvn-dependency-check-to-sbom</artifactId>
        <configuration>
          <tags>jira-wa</tags>
        </configuration>
      </plugin>
    </plugins>
  </build>
  
  <dependencies>
  <!-- https://mvnrepository.com/artifact/org.apache.pdfbox/pdfbox -->
    <dependency>
        <groupId>org.apache.pdfbox</groupId>
        <artifactId>pdfbox</artifactId>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-thumbsdb</artifactId>
      <version>${monkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-tga</artifactId>
      <version>${monkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-sgi</artifactId>
      <version>${monkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-psd</artifactId>
      <version>${monkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-pnm</artifactId>
      <version>${monkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-pdf</artifactId>
      <version>${monkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-pcx</artifactId>
      <version>${monkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-jpeg</artifactId>
      <version>${monkeys.version}</version> <!-- Alternatively, build your own version -->
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-iff</artifactId>
      <version>${monkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-hdr</artifactId>
      <version>${monkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-bmp</artifactId>
      <version>${monkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-clippath</artifactId>
      <version>${monkeys.version}</version>
    </dependency>
    <dependency>
      <groupId>net.sf.jcgm</groupId>
      <artifactId>jcgm-core</artifactId>
      <version>2.1.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>net.sf.jcgm</groupId>
      <artifactId>jcgm-image</artifactId>
      <version>${jcgm.image.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  
</project>
